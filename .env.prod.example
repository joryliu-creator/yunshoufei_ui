# 生产环境只允许只读巡检。BASE_URL、客户号和只读账号待补充。
TEST_ENV=prod
BASE_URL=
CUSTOMER_ID=
# TEST_DATA_WORKBOOK=D:\path\to\UI自动化回归测试用例模板_Demo.xlsx

# 按 C<客户号>_READONLY_USERNAME/PASSWORD/CAPTCHA 维护本地凭据。

# 生产环境必须保持全部副作用开关为 false，代码层也会阻止 side_effect 用例。
ALLOW_BILL_CREATION=false
CLEANUP_CREATED_BILL=false
ALLOW_BILL_DELETION=false
