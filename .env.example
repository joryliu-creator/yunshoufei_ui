# 兼容旧单环境模式；新配置请优先复制对应的 .env.<环境>.example。
# .env 和 .env.<环境> 均不应提交到版本库。
TEST_ENV=standard1
BASE_URL=http://t.jslife.net/jportal/index.html
CUSTOMER_ID=93537
MASTER_CUSTOMER_ID=93537
TEST_USERNAME=
TEST_PASSWORD=

# 如测试环境提供固定验证码，可在此配置；否则由运行时人工输入。
CAPTCHA=

# 多账号凭据按“账号别名大写_USERNAME/PASSWORD/CAPTCHA”维护。
# Excel 只填写账号别名，不填写以下真实值。
# BILLING_ADMIN_USERNAME=
# BILLING_ADMIN_PASSWORD=
# BILLING_ADMIN_CAPTCHA=0000
# CASHIER_USERNAME=
# CASHIER_PASSWORD=
# CASHIER_CAPTCHA=0000
# FINANCE_ADMIN_USERNAME=
# FINANCE_ADMIN_PASSWORD=
# FINANCE_ADMIN_CAPTCHA=0000

# 项目、房间、收费项、账期、日期和账号别名统一维护在 Excel。
# TEST_DATA_WORKBOOK=D:\path\to\UI自动化回归测试用例模板_Demo.xlsx

# 危险操作授权只能维护在本地环境文件，默认全部关闭。
ALLOW_BILL_CREATION=false
CLEANUP_CREATED_BILL=false
ALLOW_BILL_DELETION=false
